# Android emulator default; iOS simulator uses http://localhost:8000/api/v1.
# Physical devices need a reachable institutional HTTPS endpoint.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
# Local development HTTP only; unset for release builds.
# SPVS_DEV_HTTP=1
# Personal Team: leave unset or use 0. Supported Apple Developer Team: opt in
# before prebuild, with Access Wi-Fi Information enabled in the signing profile.
# SPVS_IOS_WIFI_INFO=1
# After Apple Developer configuration, select development or production before prebuild.
# SPVS_APP_ATTEST_ENV=development
