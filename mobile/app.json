{
  "expo": {
    "name": "SPVS Student",
    "slug": "spvs-student",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "edu.spvs.student",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Capture face samples for consented enrollment and attendance verification.",
        "NSLocationWhenInUseUsageDescription": "Verify your location during an attendance attempt."
      }
    },
    "android": {
      "package": "edu.spvs.student",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_STATE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SPVS to capture your face for attendance verification.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      ["expo-secure-store", {"faceIDPermission": false}],
      "expo-dev-client",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SPVS to verify your location during attendance.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": false
        }
      ]
    ]
  }
}
