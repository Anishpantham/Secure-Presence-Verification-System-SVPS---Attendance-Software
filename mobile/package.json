{
  "name": "spvs-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "export": "expo export --platform android --platform ios",
    "prebuild": "expo prebuild --no-install",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "expo": "58.0.17",
    "expo-camera": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.10",
    "expo-image-manipulator": "~58.0.15",
    "expo-location": "~58.0.18",
    "expo-modules-core": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.1.0",
    "react-test-renderer": "19.3.0",
    "typescript": "~5.8.3",
    "vitest": "5.0.5"
  }
}
