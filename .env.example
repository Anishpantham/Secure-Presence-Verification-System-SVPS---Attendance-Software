# Run python scripts/init_env.py to generate unique local secrets. Never commit .env.
POSTGRES_USER=spvs
POSTGRES_DB=spvs
# Container backend target; set to spvs_recovery only when using that recovered DB.
# This does not create, restore, or rename databases. Host API uses DATABASE_URL.
SPVS_BACKEND_DB=spvs
POSTGRES_PASSWORD=GENERATE_LOCALLY
DATABASE_URL=postgresql+psycopg://spvs:GENERATE_LOCALLY@localhost:5432/spvs
JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
BIOMETRIC_KEY=GENERATE_FERNET_KEY
DEMO_PASSWORD=GENERATE_UNIQUE_LOCAL_DEMO_PASSWORD
CORS_ORIGINS=http://localhost:5173
MODEL_DIR=../models
ENVIRONMENT=development
ALLOW_REGISTRATION=false
ALLOW_LEGACY_DEVICE_REGISTRATION=false
# Optional App Attest deployment configuration; see docs/CROSS_PLATFORM_IMPLEMENTATION.md
APPLE_APP_ID=
APPLE_ATTEST_ENVIRONMENT=production
APPLE_ATTEST_ROOT_SHA256=
# Set APPLE_ATTEST_ROOT_PEM only to a real, independently verified Apple root PEM path.
